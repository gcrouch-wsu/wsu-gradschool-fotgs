# Required for admin sign-in and stable private EMPLID hashing.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=
AUTH_SECRET=

# Added automatically on Vercel when you connect a private Blob store to this project.
BLOB_READ_WRITE_TOKEN=

# Optional. Leave unset for private Blob stores.
# Set to "public" only if you intentionally created a public Blob store.
FOTGS_BLOB_ACCESS=private
